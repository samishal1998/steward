---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const variants = [
  { id: 'waymark', name: 'Waymark', number: '01', position: 'Abstract route / S monogram', accent: '#ef9458', line: 'Give every route a clear way home.', voice: 'Warm, precise, quietly capable.', story: 'One continuous route becomes an S. Rounded turns suggest careful changes; the two endpoints keep it grounded in real connections.', right: 'A memorable, product-specific identity that can grow beyond proxies.', cost: 'The routing metaphor is subtle; the name and repetition carry the meaning.' },
  { id: 'gatehouse', name: 'Gatehouse', number: '02', position: 'Architectural gateway', accent: '#a8c6ae', line: 'Make changes. Keep your bearings.', voice: 'Calm, dependable, protective.', story: 'A doorway with a central route. The structure suggests a steward keeping the boundary intact while traffic passes through.', right: 'An approachable, dependable infrastructure tool with ownership at its heart.', cost: 'The gate/protection metaphor can read as a security product.' },
  { id: 'switchboard', name: 'Switchboard', number: '03', position: 'Literal connection diagram', accent: '#91b8ed', line: 'Know what connects. Control what changes.', voice: 'Technical, clear, direct.', story: 'Two routes meet at one controlled junction. The native nodes stay visible rather than disappearing into a dashboard abstraction.', right: 'Immediate recognition as a tool for routes, connections and control.', cost: 'Network diagrams are familiar, so the symbol is less ownable.' },
];
---
<div class="brand-explorer">
  <p class="brand-intro">Three answers to one brief: a recognizable mark for a small, careful infrastructure tool. The primary axis is how literally the mark expresses routing. Choose the symbol first; voice and accent follow it.</p>
  {variants.map((v, index) => (
    <section class="brand-direction" data-direction={v.id} hidden={index !== 0} style={`--brand-accent:${v.accent}`} aria-label={`${v.name} brand direction`}>
      <div class="direction-label"><span>{v.number} / {v.name}</span><span>{v.position}</span></div>
      <div class="brand-hero">
        <div class="brand-lockup"><img src={`${base}/brand/${v.id}.svg`} width="80" height="80" alt={`${v.name} logo`} /><span>steward</span></div>
        <h2>{v.line}</h2>
        <p>{v.voice} Native routes. Explicit ownership. Careful changes.</p>
        <div class="brand-demo"><span>$</span><code>steward routes add app --proxy local<br />  --host app.localhost --upstream http://127.0.0.1:3000 --tls http</code></div>
      </div>
      <div class="brand-contexts">
        <div class="brand-context"><span class="context-label">APP ICON / DARK</span><div class="brand-app-icon"><img src={`${base}/brand/${v.id}.svg`} alt="" width="48" height="48" /></div><strong>steward</strong><span>Native tools, clear control.</span></div>
        <div class="brand-context"><span class="context-label">MONOCHROME / SMALL</span><div class="brand-sizes">{[16, 32, 64].map(size => <img src={`${base}/brand/${v.id}.svg`} alt={`${size} pixel ${v.name} mark`} width={size} height={size} />)}</div><span>One color. No gradients.<br />Readable at favicon scale.</span></div>
        <div class="brand-context"><span class="context-label">PRODUCT CHROME</span><div class="brand-mini-header"><img src={`${base}/brand/${v.id}.svg`} width="24" height="24" alt="" /><strong>steward</strong><span>Docs</span></div><p>Get started<br /><b>Your first app. One clear route.</b></p></div>
      </div>
      <div class="brand-rationale"><p>{v.story}</p><dl><div><dt>Right when</dt><dd>{v.right}</dd></div><div><dt>Tradeoff</dt><dd>{v.cost}</dd></div></dl><a href={`${base}/brand/${v.id}.svg`} download={`${v.id}.svg`}>Download {v.name} SVG <span aria-hidden="true">↗</span></a></div>
    </section>
  ))}
  <p class="brand-note">Concepts, not a final identity. No direction has been promoted into the product. Share this page with <code>?variant=waymark</code>, <code>?variant=gatehouse</code>, or <code>?variant=switchboard</code>.</p>
</div>
<nav class="variant-picker" aria-label="Brand variants">
  {variants.map((v, index) => <button type="button" data-variant={v.id} aria-current={index === 0 ? 'true' : 'false'}>{v.name}</button>)}
</nav>
<script>
  const names = ['waymark', 'gatehouse', 'switchboard'];
  function select(value: string, update = true) {
    const selected = names.includes(value) ? value : names[0];
    document.querySelectorAll<HTMLElement>('[data-direction]').forEach(el => { el.hidden = el.dataset.direction !== selected; });
    document.querySelectorAll<HTMLButtonElement>('[data-variant]').forEach(el => el.setAttribute('aria-current', String(el.dataset.variant === selected)));
    if (update) { const url = new URL(location.href); url.searchParams.set('variant', selected); history.replaceState(null, '', url); }
  }
  select(new URL(location.href).searchParams.get('variant') || names[0], false);
  document.querySelectorAll<HTMLButtonElement>('[data-variant]').forEach(el => el.addEventListener('click', () => select(el.dataset.variant!)));
  window.addEventListener('popstate', () => select(new URL(location.href).searchParams.get('variant') || names[0], false));
  document.addEventListener('keydown', event => {
    const target = event.target as HTMLElement;
    if (event.ctrlKey || event.altKey || event.metaKey || target.closest('input,textarea,select,[contenteditable="true"]')) return;
    const current = names.indexOf(document.querySelector<HTMLButtonElement>('[data-variant][aria-current="true"]')?.dataset.variant || names[0]);
    let next: number | undefined;
    if (/^[1-3]$/.test(event.key)) next = Number(event.key) - 1;
    if (event.key === 'ArrowRight') next = (current + 1) % names.length;
    if (event.key === 'ArrowLeft') next = (current + names.length - 1) % names.length;
    if (next !== undefined) { event.preventDefault(); select(names[next]); }
  });
</script>
<style>
  :global(body:has(.brand-explorer) h1) { margin-top: 4.5rem; }
  .brand-explorer { padding-bottom: 5rem; }
  .brand-intro,.brand-note { color: var(--sl-color-gray-2); font-size: .9rem; line-height: 1.8; }
  .brand-direction[hidden] { display: none; }
  .direction-label { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .6rem; margin-block: 2rem 1rem; font: .7rem/1.5 ui-monospace,monospace; color: var(--sl-color-gray-2); }
  .brand-hero { padding: clamp(1.4rem,5vw,3rem); border-radius: 24px; background: #f3efe3; color: #101722; box-shadow: 0 0 0 1px #0001; }
  .brand-lockup { display: flex; align-items: center; gap: 1rem; }
  .brand-lockup img { flex: none; width: clamp(52px,8vw,80px); height: auto; }
  .brand-lockup > span { font-size: clamp(2.7rem,7vw,4.8rem); font-weight: 650; letter-spacing: -.065em; line-height: 1; }
  .brand-hero h2 { margin: 2rem 0 .8rem; padding: 0; border: 0; font-size: clamp(1.5rem,4vw,2.4rem); max-width: 18ch; font-weight: 580; line-height: 1.15; }
  .brand-hero p { color: #4b514f; font-size: .9rem; max-width: 34ch; }
  .brand-demo { display: flex; align-items: flex-start; gap: .8rem; padding: 1rem; margin-top: 1.8rem; border-radius: 12px; background: #101722; color: #f6f5ef; font-size: .7rem; }
  .brand-demo > span { color: var(--brand-accent); font: inherit; }
  .brand-demo code { background: none; color: inherit; padding: 0; overflow-wrap: anywhere; }
  .brand-contexts { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,13rem),1fr)); gap: .75rem; margin-block: .75rem 1.5rem; }
  .brand-context { min-width: 0; margin: 0; padding: 1.2rem; border-radius: 16px; background: var(--sl-color-gray-6); border: 1px solid var(--sl-color-gray-5); display: flex; flex-direction: column; gap: .6rem; }
  .context-label { font: .56rem/1.5 ui-monospace,monospace; letter-spacing: .06em; color: var(--sl-color-gray-2); }
  .brand-app-icon { width: 76px; height: 76px; padding: 14px; border-radius: 22px; margin-top: .7rem; background: #101722; box-shadow: inset 0 0 0 1px #ffffff1a,0 4px 14px #0002; }
  .brand-app-icon img { filter: brightness(0) invert(1); }
  .brand-context > strong { font-size: .85rem; letter-spacing: -.04em; }
  .brand-context > span:last-child { font-size: .7rem; color: var(--sl-color-gray-2); }
  .brand-sizes { display: flex; align-items: center; gap: .8rem; min-height: 100px; padding: .5rem; border-radius: 10px; background: #f3efe3; }
  .brand-mini-header { display: flex; align-items: center; gap: .45rem; padding: .8rem .5rem; margin-top: .7rem; border-radius: 10px; background: #f3efe3; color: #101722; font-size: .85rem; }
  .brand-mini-header > span { margin-left: auto; font-size: .65rem; color: #4b514f; }
  .brand-context p { font-size: .75rem; line-height: 1.8; }
  .brand-context b { font-weight: 550; }
  .brand-rationale { font-size: .85rem; line-height: 1.8; }
  .brand-rationale dl { display: grid; gap: .75rem; }
  .brand-rationale dt { font-size: .65rem; text-transform: uppercase; letter-spacing: .09em; color: var(--sl-color-gray-2); }
  .brand-rationale dd { margin: 0; }
  .brand-rationale a { display: inline-flex; gap: 1rem; align-items: center; min-height: 44px; margin-top: 1rem; font-weight: 600; }
  .variant-picker { position: fixed; top: 84px; left: 50%; translate: -50% 0; z-index: 2147483647; display: flex; gap: 2px; padding: 4px; border-radius: 999px; background: rgb(20 20 20 / .9); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .1),0 8px 24px rgb(0 0 0 / .25); font: 13px/1 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; user-select: none; }
  .variant-picker button { padding: 7px 14px; min-height: 44px; border: 0; border-radius: 999px; background: none; color: rgb(255 255 255 / .6); cursor: pointer; font: inherit; }
  .variant-picker button:hover { color: rgb(255 255 255 / .85); }
  .variant-picker button[aria-current='true'] { background: rgb(255 255 255 / .14); color: white; }
  .variant-picker button:focus-visible { outline: 2px solid rgb(255 255 255 / .7); outline-offset: 2px; }
</style>
